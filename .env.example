# Copy to .env.local and fill in. Keys are only read by server route handlers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
POLYPIZZA_API_KEY=
# Sharing: project URL plus a server key (a secret key sb_secret_..., or the legacy
# service_role key). Only the server uses them. Without them, dev saves to .data/.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Not used: the browser never talks to Supabase directly.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
TRIPO_API_KEY=            # optional, Phase 5+
FEATURE_TEXT_TO_3D=false
